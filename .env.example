# ──────────────────────────────────────────────────────────────────────────────
# Sentinel — environment contract
# Copy to .env and fill in. `.env` is gitignored; never commit secrets.
# The backend auto-loads .env at startup (python-dotenv).
# ──────────────────────────────────────────────────────────────────────────────

# Connector / store selection ───────────────────────────────────────────────────
# corpus: vertex | mock     (mock = hermetic in-memory RAG, no GCP needed)
# store:  firestore | mock  (mock = in-memory quarantine queue)
SENTINEL_CORPUS=vertex
SENTINEL_STORE=firestore

# Reasoning — Gemini ────────────────────────────────────────────────────────────
# Provider: vertex (Vertex AI, uses ADC) | ai_studio (uses GEMINI_API_KEY)
SENTINEL_LLM_PROVIDER=vertex
# gemini-2.5-flash is fast (recommended for the live demo); gemini-2.5-pro is more thorough.
SENTINEL_GEMINI_MODEL=gemini-2.5-flash
# Only needed when SENTINEL_LLM_PROVIDER=ai_studio
GEMINI_API_KEY=

# Google Cloud ──────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=riverside-sentinel
GOOGLE_CLOUD_LOCATION=us-central1
# Vertex AI embeddings + vector search (live corpus path)
# Vertex provider: text-embedding-005. AI Studio provider: gemini-embedding-001.
SENTINEL_EMBEDDING_MODEL=text-embedding-005
VERTEX_VECTOR_INDEX_ENDPOINT=
VERTEX_VECTOR_DEPLOYED_INDEX_ID=
# Firestore collection prefix for the quarantine queue + verdict audit log
SENTINEL_FIRESTORE_PREFIX=sentinel

# Arize Phoenix — tracing, evals, MCP introspection ─────────────────────────────
# Free Phoenix Cloud account: https://app.phoenix.arize.com
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=sentinel
# The ADK agent spawns a built-in Phoenix MCP server in-process (over stdio) and
# calls it at runtime — no endpoint needed. Set this only to point the agent at
# an external Phoenix MCP server instead.
PHOENIX_MCP_ENDPOINT=

# Org policy — quarantine thresholds (the ORG sets these, not the agent) ─────────
# Grounding score below which a high-stakes specific claim is quarantined.
SENTINEL_QUARANTINE_THRESHOLD=0.55
# Hallucination eval score above which an answer is quarantined regardless.
SENTINEL_HALLUCINATION_THRESHOLD=0.5
# Enable the optional REPAIR-and-cite path (drafts a corrected, sourced answer).
SENTINEL_ENABLE_REPAIR=true
